{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "always",
  "endOfLine": "lf",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "/dist",
    "/coverage",
    "/data",
    "/.nx",
    ".angular",
    "Dockerfile",
    ".dockerignore",
    "pnpm-lock.yaml",
    "web/src/app/blog/generated/",
    "libs/stats/src/lib/models/pushup-type-content.generated.ts",
    "libs/stats/src/lib/models/exercise-wiki-content.generated.ts",
    "libs/stats/src/lib/models/training-plan-content.generated.ts"
  ]
}
